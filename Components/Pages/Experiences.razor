@page "/experiences"
@rendermode InteractiveServer

<PageTitle>Curated Experiences - Atlas Escapes</PageTitle>

<main class="tourism-layout">
    <!-- Shared Header -->
    <header class="navbar">
        <div class="nav-group left-links">
            <a href="/">HOME</a> 
            <span class="dot-separator">•</span>
            <a href="/experiences">EXPERIENCES</a>
        </div>
        
        <div class="nav-brand">
            <a href="/"><h1>Atlas Escapes</h1></a>
        </div>

        <div class="nav-group right-links">
            <a href="/about">ABOUT</a>
            <span class="dot-separator">•</span>
            <a href="#contact">CONTACT</a>
        </div>
    </header>

    <!-- Inner Page Hero -->
    <section class="inner-hero bg-experiences-hero">
        <div class="hero-overlay">
            <h1 class="animate-up">Curated Experiences</h1>
            <p class="animate-up delay-1">Explore, filter, and plan your next global adventure.</p>
        </div>
    </section>

    <!-- Interactive Control Bar -->
    <section class="controls-section">
        <div class="controls-container">
            <!-- Live Search Bar -->
            <div class="search-box">
                <span class="search-icon">🔍</span>
                <input type="text" placeholder="Search destination or title..." @bind="SearchQuery" @bind:event="oninput" />
            </div>

            <!-- Price & Duration Sorting -->
            <div class="sort-box">
                <label for="sort">Sort by:</label>
                <select id="sort" @onchange="OnSortChanged">
                    <option value="featured">Featured</option>
                    <option value="price-low">Price: Low to High</option>
                    <option value="price-high">Price: High to Low</option>
                    <option value="duration">Duration</option>
                </select>
            </div>

            <!-- Saved Wishlist Counter -->
            <div class="wishlist-badge">
                ❤️ Saved: <strong>@WishlistCount</strong>
            </div>
        </div>

        <!-- Category Filters -->
        <div class="filter-bar">
            @foreach (var category in Categories)
            {
                <button class="filter-btn @(SelectedCategory == category ? "active" : "")" 
                        @onclick="() => SelectCategory(category)">
                    @category
                </button>
            }
        </div>
    </section>

    <!-- Tour Packages Grid -->
    <section class="packages-section section-padding bg-light">
        <div class="container">
            <div class="results-meta">
                Showing <strong>@FilteredTours.Count</strong> experiences
            </div>

            @if (FilteredTours.Count == 0)
            {
                <div class="no-results">
                    <h3>No matching experiences found</h3>
                    <p>Try adjusting your search query or filter criteria.</p>
                    <button class="btn-primary" @onclick="ResetFilters">Reset Filters</button>
                </div>
            }
            else
            {
                <div class="packages-grid">
                    @foreach (var tour in FilteredTours)
                    {
                        <div class="package-card animate-scale">
                            <div class="package-img @tour.ImageClass">
                                <span class="pkg-tag">@tour.Category</span>
                                <button class="wishlist-btn @(tour.IsFavorite ? "liked" : "")" 
                                        @onclick="() => ToggleWishlist(tour)" 
                                        title="Save to Wishlist">
                                    ♥
                                </button>
                            </div>
                            <div class="package-content">
                                <div class="pkg-meta">
                                    <span>⏱️ @tour.DurationDays Days</span>
                                    <span>📍 @tour.Country</span>
                                </div>
                                <h3>@tour.Title</h3>
                                <p>@tour.Description</p>
                                <div class="pkg-footer">
                                    <div class="price">From <strong>$@tour.Price.ToString("N0")</strong></div>
                                    <button class="btn-primary" @onclick="() => OpenModal(tour)">View Itinerary</button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </section>

    <!-- Tour Detail & Price Calculator Modal -->
    @if (SelectedTour != null)
    {
        <div class="modal-backdrop" @onclick="CloseModal">
            <div class="modal-card" @onclick:stopPropagation="true">
                <button class="modal-close" @onclick="CloseModal">×</button>
                
                <div class="modal-header @SelectedTour.ImageClass">
                    <span class="modal-tag">@SelectedTour.Category</span>
                    <h2>@SelectedTour.Title</h2>
                    <p>📍 @SelectedTour.Country • ⏱️ @SelectedTour.DurationDays Days</p>
                </div>

                <div class="modal-body">
                    <h4>Included Tour Highlights</h4>
                    <ul class="highlights-list">
                        @foreach (var highlight in SelectedTour.Highlights)
                        {
                            <li>✓ @highlight</li>
                        }
                    </ul>

                    <hr />

                    <h4>Plan Your Reservation</h4>
                    <div class="booking-calculator">
                        <div class="calc-row">
                            <label>Number of Guests:</label>
                            <input type="number" min="1" max="10" @bind="GuestCount" @bind:event="oninput" />
                        </div>
                        <div class="calc-row total-row">
                            <span>Estimated Total:</span>
                            <span class="total-price">$@((SelectedTour.Price * GuestCount).ToString("N0"))</span>
                        </div>
                    </div>

                    @if (IsBookingConfirmed)
                    {
                        <div class="booking-alert success">
                            🎉 Success! Reservation draft saved for @GuestCount guest(s).
                        </div>
                    }
                    else
                    {
                        <button class="btn-primary-pill full-width" @onclick="ConfirmBooking">Confirm Reservation Draft</button>
                    }
                </div>
            </div>
        </div>
    }

    <!-- Shared Footer -->
    <footer class="site-footer">
        <div class="footer-grid">
            <div class="footer-col">
                <h5>Information</h5>
                <ul>
                    <li><a href="/about">About us</a></li>
                    <li><a href="#">Travel Visas</a></li>
                    <li><a href="#">Insurance</a></li>
                    <li><a href="#">General enquiries</a></li>
                    <li><a href="#">Booking conditions</a></li>
                    <li><a href="#">Privacy policy</a></li>
                    <li><a href="#">Refund policy</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h5>Experiences</h5>
                <ul>
                    <li><a href="#">Northern Lights</a></li>
                    <li><a href="#">African Safari</a></li>
                    <li><a href="#">European Rail</a></li>
                    <li><a href="#">Island Hopping</a></li>
                    <li><a href="#">Culinary Tours</a></li>
                    <li><a href="#">Ancient Ruins</a></li>
                    <li><a href="#">Mountain Trekking</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h5>Travel Styles</h5>
                <ul>
                    <li><a href="#">Solo Travel</a></li>
                    <li><a href="#">Honeymoons</a></li>
                    <li><a href="#">Family Escapes</a></li>
                    <li><a href="#">Backpacking</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h5>Popular global destinations</h5>
                <div class="destinations-split">
                    <ul>
                        <li><a href="#">Paris, France</a></li>
                        <li><a href="#">Tokyo, Japan</a></li>
                        <li><a href="#">Rome, Italy</a></li>
                        <li><a href="#">Cape Town, SA</a></li>
                        <li><a href="#">Banff, Canada</a></li>
                        <li><a href="#">Bali, Indonesia</a></li>
                        <li><a href="#">Cairo, Egypt</a></li>
                    </ul>
                    <ul>
                        <li><a href="#">Reykjavik, Iceland</a></li>
                        <li><a href="#">Cusco, Peru</a></li>
                        <li><a href="#">Sydney, Australia</a></li>
                        <li><a href="#">Seoul, South Korea</a></li>
                        <li><a href="#">Dubai, UAE</a></li>
                        <li><a href="#">Auckland, NZ</a></li>
                        <li><a href="#">New York, USA</a></li>
                    </ul>
                </div>
            </div>
            <div class="footer-col contact-info">
                <p>Phone: +1 (800) 555-0199</p>
                <p>Email: hello@atlasescapes.com</p>
                <br />
                <p><strong>Headquarters</strong></p>
                <p>420 Global Plaza,</p>
                <p>International District,</p>
                <p>London - EC1A 1BB,</p>
                <p>United Kingdom</p>
            </div>
        </div>
    </footer>
</main>