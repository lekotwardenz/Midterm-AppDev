@page "/about"

<PageTitle>About Us - Atlas Escapes</PageTitle>

<main class="tourism-layout">
    <!-- Top Navigation -->
    <header class="navbar">
        <div class="nav-group left-links">
            <!-- Links to Home.razor -->
            <a href="/">HOME</a> 
            <span class="dot-separator">•</span>
            <!-- Links to Experiences.razor -->
            <a href="/experiences">EXPERIENCES</a>
        </div>
        
        <div class="nav-brand">
            <!-- Clicking the logo also goes back home -->
            <a href="/"><h1>Atlas Escapes</h1></a>
        </div>

        <div class="nav-group right-links">
            <!-- Links to About.razor -->
            <a href="/about">ABOUT</a>
            <span class="dot-separator">•</span>
            <a href="#contact">CONTACT</a>
        </div>
    </header>

    <!-- Inner Hero -->
    <section class="inner-hero bg-about-hero">
        <div class="hero-overlay">
            <h1 class="animate-up">Our Story</h1>
            <p class="animate-up delay-1">We believe the world is meant to be explored.</p>
        </div>
    </section>

    <!-- Content Section -->
    <section class="story-section section-padding">
        <div class="story-container">
            <div class="story-text animate-up delay-2">
                <h2>Redefining Global Travel</h2>
                <div class="divider"><span>♦</span><span>♦</span><span>♦</span></div>
                <p>Founded in 2018, Atlas Escapes was born from a simple idea: that travel should be more than just checking boxes on a list. It should be about genuine connections, breathtaking moments, and discovering the soul of a destination.</p>
                <p>Our team of global experts personally vets every lodge, train route, and local guide we recommend. We handle the logistics so you can focus entirely on the experience.</p>
            </div>
            <div class="story-image-wrapper animate-scale delay-2">
                <div class="story-image bg-story-pic"></div>
                <div class="experience-badge">
                    <strong>10+</strong>
                    <span>Years<br/>Experience</span>
                </div>
            </div>
        </div>
    </section>

    <!-- Stats Section -->
    <section class="stats-section bg-primary-dark text-white">
        <div class="stats-grid">
            <div class="stat-item animate-up">
                <h3>150+</h3>
                <p>Curated Destinations</p>
            </div>
            <div class="stat-item animate-up delay-1">
                <h3>10k+</h3>
                <p>Happy Travelers</p>
            </div>
            <div class="stat-item animate-up delay-2">
                <h3>50</h3>
                <p>Expert Guides</p>
            </div>
            <div class="stat-item animate-up delay-3">
                <h3>24/7</h3>
                <p>Global Support</p>
            </div>
        </div>
    </section>
    <footer class="site-footer">
        <!-- Footer content remains exactly the same as previous step -->
        <div class="footer-grid">
            <div class="footer-col">
                <h5>Information</h5>
                <ul>
                    <li><a href="#">About us</a></li>
                    <li><a href="#">Travel Visas</a></li>
                    <li><a href="#">Insurance</a></li>
                    <li><a href="#">General enquiries</a></li>
                    <li><a href="#">Booking conditions</a></li>
                    <li><a href="#">Privacy policy</a></li>
                    <li><a href="#">Refund policy</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h5>Experiences</h5>
                <ul>
                    <li><a href="#">Northern Lights</a></li>
                    <li><a href="#">African Safari</a></li>
                    <li><a href="#">European Rail</a></li>
                    <li><a href="#">Island Hopping</a></li>
                    <li><a href="#">Culinary Tours</a></li>
                    <li><a href="#">Ancient Ruins</a></li>
                    <li><a href="#">Mountain Trekking</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h5>Travel Styles</h5>
                <ul>
                    <li><a href="#">Solo Travel</a></li>
                    <li><a href="#">Honeymoons</a></li>
                    <li><a href="#">Family Escapes</a></li>
                    <li><a href="#">Backpacking</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h5>Popular global destinations</h5>
                <div class="destinations-split">
                    <ul>
                        <li><a href="#">Paris, France</a></li>
                        <li><a href="#">Tokyo, Japan</a></li>
                        <li><a href="#">Rome, Italy</a></li>
                        <li><a href="#">Cape Town, SA</a></li>
                        <li><a href="#">Banff, Canada</a></li>
                        <li><a href="#">Bali, Indonesia</a></li>
                        <li><a href="#">Cairo, Egypt</a></li>
                    </ul>
                    <ul>
                        <li><a href="#">Reykjavik, Iceland</a></li>
                        <li><a href="#">Cusco, Peru</a></li>
                        <li><a href="#">Sydney, Australia</a></li>
                        <li><a href="#">Seoul, South Korea</a></li>
                        <li><a href="#">Dubai, UAE</a></li>
                        <li><a href="#">Auckland, NZ</a></li>
                        <li><a href="#">New York, USA</a></li>
                    </ul>
                </div>
            </div>
            <div class="footer-col contact-info">
                <p>Phone: +1 (800) 555-0199</p>
                <p>Email: hello@atlasescapes.com</p>
                <br />
                <p><strong>Headquarters</strong></p>
                <p>420 Global Plaza,</p>
                <p>International District,</p>
                <p>London - EC1A 1BB,</p>
                <p>United Kingdom</p>
            </div>
        </div>
    </footer>
</main>