@page "/"

<PageTitle>Atlas Escapes - Global Journeys</PageTitle>

<main class="tourism-layout">
    <!-- Top Navigation -->
    <header class="navbar">
        <div class="nav-group left-links">
            <!-- Links to Home.razor -->
            <a href="/">HOME</a> 
            <span class="dot-separator">•</span>
            <!-- Links to Experiences.razor -->
            <a href="/experiences">EXPERIENCES</a>
        </div>
        
        <div class="nav-brand">
            <!-- Clicking the logo also goes back home -->
            <a href="/"><h1>Atlas Escapes</h1></a>
        </div>

        <div class="nav-group right-links">
            <!-- Links to About.razor -->
            <a href="/about">ABOUT</a>
            <span class="dot-separator">•</span>
            <a href="#contact">CONTACT</a>
        </div>
    </header>

    <!-- Hero Section -->
    <section class="hero-section bg-hero">
        <div class="hero-content">
            <h2>EXPLORE EVERY CORNER</h2>
        </div>
    </section>

    <!-- Overlapping Search Bar -->
    <div class="search-container">
        <div class="search-bar">
            <div class="search-input">
                <span class="icon">📍</span>
                <input type="text" placeholder="Tokyo, Japan" />
            </div>
            <div class="search-input">
                <span class="icon">📅</span>
                <input type="text" placeholder="Check-in" />
            </div>
            <div class="search-input">
                <span class="icon">📅</span>
                <input type="text" placeholder="Check-out" />
            </div>
            <div class="search-input">
                <span class="icon">👤</span>
                <input type="text" placeholder="Guests" />
            </div>
            <button class="btn-search">→</button>
        </div>
    </div>

    <!-- Latest Vacation Ideas -->
    <section class="vacation-ideas section-padding">
        <div class="section-header">
            <h3>See latest vacation ideas</h3>
            <div class="divider"><span>♦</span><span>♦</span><span>♦</span></div>
        </div>

        <div class="ideas-grid">
            <div class="idea-card bg-idea-alpine">
                <div class="idea-label">Alpine Retreats</div>
            </div>
            <div class="idea-card bg-idea-safari">
                <div class="idea-label">Safari Adventures</div>
            </div>
            <div class="idea-card bg-idea-city">
                <div class="idea-label">Historic City Breaks</div>
            </div>
        </div>
    </section>

    <!-- Recent Holiday Locations -->
    <section class="recent-locations section-padding bg-light">
        <div class="section-header">
            <h3>Trending global locations</h3>
            <div class="divider"><span>♦</span><span>♦</span><span>♦</span></div>
        </div>

        <div class="locations-grid">
            <!-- Card 1: Mountain/Snow -->
            <div class="location-card">
                <div class="location-gallery">
                    <div class="main-img bg-loc1-main"></div>
                    <div class="thumb-row">
                        <div class="thumb bg-loc1-t1"></div>
                        <div class="thumb bg-loc1-t2"></div>
                        <div class="thumb bg-loc1-t3"></div>
                    </div>
                </div>
                <div class="location-info">
                    <h4>The Alpine Lodge</h4>
                    <p>Nestled in the shadow of the Swiss Alps, this luxury cabin offers ski-in/ski-out access, a heated stone hearth, and breathtaking mountain vistas.</p>
                    <div class="amenities">
                        <span>🛏️ 3</span>
                        <span>🛁 2</span>
                        <span>🏔️ Mountain View</span>
                    </div>
                    <button class="btn-primary">BOOK NOW</button>
                </div>
            </div>

            <!-- Card 2: Cultural/City -->
            <div class="location-card">
                <div class="location-gallery">
                    <div class="main-img bg-loc2-main"></div>
                    <div class="thumb-row">
                        <div class="thumb bg-loc2-t1"></div>
                        <div class="thumb bg-loc2-t2"></div>
                        <div class="thumb bg-loc2-t3"></div>
                    </div>
                </div>
                <div class="location-info">
                    <h4>Kyoto Zen Retreat</h4>
                    <p>A beautifully restored machiya townhouse in the heart of Japan. Steps away from ancient temples, traditional tea houses, and tranquil bamboo forests.</p>
                    <div class="amenities">
                        <span>🛏️ 2</span>
                        <span>🛁 1</span>
                        <span>🎋 Garden</span>
                    </div>
                    <button class="btn-primary">BOOK NOW</button>
                </div>
            </div>

            <!-- Card 3: Desert/Architecture -->
            <div class="location-card">
                <div class="location-gallery">
                    <div class="main-img bg-loc3-main"></div>
                    <div class="thumb-row">
                        <div class="thumb bg-loc3-t1"></div>
                        <div class="thumb bg-loc3-t2"></div>
                        <div class="thumb bg-loc3-t3"></div>
                    </div>
                </div>
                <div class="location-info">
                    <h4>Riad Al-Fassi</h4>
                    <p>Experience the vibrant heart of Marrakech, Morocco. Featuring a traditional central courtyard, intricate mosaic tiles, and a rooftop terrace overlooking the Medina.</p>
                    <div class="amenities">
                        <span>🛏️ 4</span>
                        <span>🛁 4</span>
                        <span>🕌 City Center</span>
                    </div>
                    <button class="btn-primary">BOOK NOW</button>
                </div>
            </div>

            <!-- Card 4: Coastal/Mediterranean -->
            <div class="location-card">
                <div class="location-gallery">
                    <div class="main-img bg-loc4-main"></div>
                    <div class="thumb-row">
                        <div class="thumb bg-loc4-t1"></div>
                        <div class="thumb bg-loc4-t2"></div>
                        <div class="thumb bg-loc4-t3"></div>
                    </div>
                </div>
                <div class="location-info">
                    <h4>Caldera Infinity Villa</h4>
                    <p>Iconic whitewashed architecture in Santorini, Greece. Enjoy private infinity pools that seemingly drop straight into the azure waters of the Aegean Sea.</p>
                    <div class="amenities">
                        <span>🛏️ 2</span>
                        <span>🛁 2</span>
                        <span>🌊 Ocean View</span>
                    </div>
                    <button class="btn-primary">BOOK NOW</button>
                </div>
            </div>
        </div>
    </section>

    <!-- Why We Are Different -->
    <section class="features-section section-padding">
        <div class="section-header">
            <h3>Why travel with us</h3>
            <div class="divider"><span>♦</span><span>♦</span><span>♦</span></div>
        </div>

        <div class="features-grid">
            <div class="feature-item">
                <div class="feature-icon bg-accent">🌍</div>
                <h4>Global Expertise</h4>
                <p>From the bustling streets of Tokyo to the remote peaks of Patagonia, our global network ensures you get authentic experiences no matter which continent you choose.</p>
            </div>
            <div class="feature-item">
                <div class="feature-icon bg-accent">🗺️</div>
                <h4>Tailored Itineraries</h4>
                <p>We don't do cookie-cutter tours. Every journey is customized to your pace, blending iconic landmarks with hidden local gems off the beaten path.</p>
            </div>
            <div class="feature-item">
                <div class="feature-icon bg-accent">🛡️</div>
                <h4>24/7 Support</h4>
                <p>Cross time zones with confidence. Whether you need a last-minute dinner reservation in Rome or flight assistance in Dubai, our concierge is always awake.</p>
            </div>
        </div>
    </section>

    <!-- Contact Banner -->
    <section class="contact-banner bg-contact">
        <div class="contact-form-container">
            <div class="contact-box">
                <h3>Start planning</h3>
                <input type="text" placeholder="Your name" />
                <input type="email" placeholder="Email" />
                <textarea placeholder="Where do you want to go?" rows="3"></textarea>
                <button class="btn-primary-pill">SEND</button>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="site-footer">
        <!-- Footer content remains exactly the same as previous step -->
        <div class="footer-grid">
            <div class="footer-col">
                <h5>Information</h5>
                <ul>
                    <li><a href="#">About us</a></li>
                    <li><a href="#">Travel Visas</a></li>
                    <li><a href="#">Insurance</a></li>
                    <li><a href="#">General enquiries</a></li>
                    <li><a href="#">Booking conditions</a></li>
                    <li><a href="#">Privacy policy</a></li>
                    <li><a href="#">Refund policy</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h5>Experiences</h5>
                <ul>
                    <li><a href="#">Northern Lights</a></li>
                    <li><a href="#">African Safari</a></li>
                    <li><a href="#">European Rail</a></li>
                    <li><a href="#">Island Hopping</a></li>
                    <li><a href="#">Culinary Tours</a></li>
                    <li><a href="#">Ancient Ruins</a></li>
                    <li><a href="#">Mountain Trekking</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h5>Travel Styles</h5>
                <ul>
                    <li><a href="#">Solo Travel</a></li>
                    <li><a href="#">Honeymoons</a></li>
                    <li><a href="#">Family Escapes</a></li>
                    <li><a href="#">Backpacking</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h5>Popular global destinations</h5>
                <div class="destinations-split">
                    <ul>
                        <li><a href="#">Paris, France</a></li>
                        <li><a href="#">Tokyo, Japan</a></li>
                        <li><a href="#">Rome, Italy</a></li>
                        <li><a href="#">Cape Town, SA</a></li>
                        <li><a href="#">Banff, Canada</a></li>
                        <li><a href="#">Bali, Indonesia</a></li>
                        <li><a href="#">Cairo, Egypt</a></li>
                    </ul>
                    <ul>
                        <li><a href="#">Reykjavik, Iceland</a></li>
                        <li><a href="#">Cusco, Peru</a></li>
                        <li><a href="#">Sydney, Australia</a></li>
                        <li><a href="#">Seoul, South Korea</a></li>
                        <li><a href="#">Dubai, UAE</a></li>
                        <li><a href="#">Auckland, NZ</a></li>
                        <li><a href="#">New York, USA</a></li>
                    </ul>
                </div>
            </div>
            <div class="footer-col contact-info">
                <p>Phone: +1 (800) 555-0199</p>
                <p>Email: hello@atlasescapes.com</p>
                <br />
                <p><strong>Headquarters</strong></p>
                <p>420 Global Plaza,</p>
                <p>International District,</p>
                <p>London - EC1A 1BB,</p>
                <p>United Kingdom</p>
            </div>
        </div>
    </footer>
</main>