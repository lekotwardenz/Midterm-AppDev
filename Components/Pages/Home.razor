@page "/"
@rendermode InteractiveServer
@using DensingMidterms.Models

<PageTitle>Atlas Escapes - Curated Luxury Travel</PageTitle>

<main class="tourism-layout">
    <!-- Top Navigation -->
    <header class="navbar">
        <div class="nav-group left-links">
            <a href="/" class="active-link">HOME</a>
            <span class="dot-separator">•</span>
            <a href="/booking">BOOKING</a>
        </div>

        <div class="nav-brand">
            <a href="/"><h1>Atlas Escapes</h1></a>
        </div>

        <div class="nav-group right-links">
            <a href="#destinations">DESTINATIONS</a>
            <span class="dot-separator">•</span>
            <a href="/booking#contact">CONTACT</a>
        </div>
    </header>

    <!-- Hero Banner -->
    <section class="hero-section bg-hero">
        <div class="hero-content">
            <h2>DISCOVER THE EXTRAORDINARY</h2>
        </div>
    </section>

    <!-- Floating Search Bar -->
    <div class="search-container">
        <div class="search-bar">
            <div class="search-input">
                <span>📍</span>
                <input type="text" placeholder="Where to?" @bind="searchDestination" />
            </div>
            <div class="search-input">
                <span>📅</span>
                <input type="text" placeholder="Check-in" @bind="searchCheckIn" />
            </div>
            <div class="search-input">
                <span>📅</span>
                <input type="text" placeholder="Check-out" @bind="searchCheckOut" />
            </div>
            <div class="search-input">
                <span>👤</span>
                <input type="number" min="1" max="20" placeholder="Guests" @bind="searchGuests" />
            </div>
            <button type="button" class="btn-search" @onclick="SearchAndBook" title="Search Tours">→</button>
        </div>
    </div>

    <!-- Travel Ideas Section -->
    <section class="section-padding">
        <div class="section-header">
            <h3>Travel Ideas</h3>
            <div class="divider"><span>♦</span><span>♦</span><span>♦</span></div>
            <p class="section-subtitle">Handpicked journeys designed around your pace, curiosity, and comfort.</p>
        </div>

        <div class="ideas-grid">
            <div class="idea-card bg-idea-alpine" @onclick='() => Navigation.NavigateTo("/booking?search=Alpine")'>
                <div class="idea-label">Alpine Escapes</div>
            </div>
            <div class="idea-card bg-idea-safari" @onclick='() => Navigation.NavigateTo("/booking?search=Safari")'>
                <div class="idea-label">Wildlife Safaris</div>
            </div>
            <div class="idea-card bg-idea-city" @onclick='() => Navigation.NavigateTo("/booking?search=Kyoto")'>
                <div class="idea-label">Cultural Trails</div>
            </div>
        </div>
    </section>

    <!-- Featured Destinations -->
    <section id="destinations" class="section-padding bg-light">
        <div class="section-header">
            <h3>Featured Destinations</h3>
            <div class="divider"><span>♦</span><span>♦</span><span>♦</span></div>
        </div>

        <div class="locations-grid">
            <div class="location-card" @onclick="() => GoToBooking(1)">
                <div class="location-gallery">
                    <div class="main-img bg-loc1-main"></div>
                    <div class="thumb-row">
                        <div class="thumb bg-loc1-t1"></div>
                        <div class="thumb bg-loc1-t2"></div>
                        <div class="thumb bg-loc1-t3"></div>
                    </div>
                </div>
                <div class="location-info">
                    <h4>Zermatt, Switzerland</h4>
                    <p>Private ski-in/ski-out alpine chalets overlooking the Matterhorn with guided glacier excursions.</p>
                    <div class="amenities">
                        <span>🏔️ Guided Treks</span>
                        <span>🚂 Glacier Express</span>
                    </div>
                    <button type="button" class="btn-primary">EXPLORE TOUR</button>
                </div>
            </div>

            <div class="location-card" @onclick="() => GoToBooking(2)">
                <div class="location-gallery">
                    <div class="main-img bg-loc2-main"></div>
                    <div class="thumb-row">
                        <div class="thumb bg-loc2-t1"></div>
                        <div class="thumb bg-loc2-t2"></div>
                        <div class="thumb bg-loc2-t3"></div>
                    </div>
                </div>
                <div class="location-info">
                    <h4>Kyoto, Japan</h4>
                    <p>Restored wooden machiya townhouses, private dawn temple walks, and traditional tea ceremonies.</p>
                    <div class="amenities">
                        <span>🍵 Tea Ceremony</span>
                        <span>⛩️ Private Guides</span>
                    </div>
                    <button type="button" class="btn-primary">EXPLORE TOUR</button>
                </div>
            </div>

            <div class="location-card" @onclick="() => GoToBooking(3)">
                <div class="location-gallery">
                    <div class="main-img bg-loc3-main"></div>
                    <div class="thumb-row">
                        <div class="thumb bg-loc3-t1"></div>
                        <div class="thumb bg-loc3-t2"></div>
                        <div class="thumb bg-loc3-t3"></div>
                    </div>
                </div>
                <div class="location-info">
                    <h4>Marrakech, Morocco</h4>
                    <p>Secluded courtyard riads in the Medina paired with luxury stargazing camps in the Sahara.</p>
                    <div class="amenities">
                        <span>🐪 Sahara Camp</span>
                        <span>🍲 Culinary Walks</span>
                    </div>
                    <button type="button" class="btn-primary">EXPLORE TOUR</button>
                </div>
            </div>

            <div class="location-card" @onclick="() => GoToBooking(4)">
                <div class="location-gallery">
                    <div class="main-img bg-loc4-main"></div>
                    <div class="thumb-row">
                        <div class="thumb bg-loc4-t1"></div>
                        <div class="thumb bg-loc4-t2"></div>
                        <div class="thumb bg-loc4-t3"></div>
                    </div>
                </div>
                <div class="location-info">
                    <h4>Santorini, Greece</h4>
                    <p>Cliffside caldera suites with private sunset catamaran sails and volcanic vineyard tastings.</p>
                    <div class="amenities">
                        <span>⛵ Private Yacht</span>
                        <span>🍷 Wine Tasting</span>
                    </div>
                    <button type="button" class="btn-primary">EXPLORE TOUR</button>
                </div>
            </div>
        </div>
    </section>

    <!-- Direct CTA Banner to Booking Page -->
    <section class="section-padding">
        <div class="cta-banner-card">
            <div class="cta-text">
                <span class="cta-badge">CUSTOMIZE &amp; INQUIRE</span>
                <h4>Ready to Build Your Itinerary?</h4>
                <p>Compare packages, calculate group estimates, save booking drafts, or send our travel concierge a direct inquiry on our Booking Planner page.</p>
            </div>
            <a href="/booking" class="btn-primary-large">GO TO BOOKING PLANNER →</a>
        </div>
    </section>

    <!-- Why Choose Us -->
    <section class="section-padding bg-light">
        <div class="section-header">
            <h3>Why Atlas Escapes</h3>
            <div class="divider"><span>♦</span><span>♦</span><span>♦</span></div>
        </div>

        <div class="features-grid">
            <div class="feature-item">
                <div class="feature-icon">✦</div>
                <h4>Bespoke Itineraries</h4>
                <p>Every route is tailored around your schedule, interests, and preferred travel rhythm.</p>
            </div>
            <div class="feature-item">
                <div class="feature-icon">🧭</div>
                <h4>Local Specialists</h4>
                <p>Partnered directly with vetted local hosts, historians, and expedition leaders.</p>
            </div>
            <div class="feature-item">
                <div class="feature-icon">🛡️</div>
                <h4>24/7 Concierge</h4>
                <p>Seamless ground support from airport arrival through every transfer and reservation.</p>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="site-footer">
        <div class="footer-grid">
            <div class="footer-col">
                <h5>Navigation</h5>
                <ul>
                    <li><a href="/">Home</a></li>
                    <li><a href="/booking">Booking Planner</a></li>
                    <li><a href="/booking#contact">Start Planning Inquiry</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h5>Top Destinations</h5>
                <div class="destinations-split">
                    <ul>
                        <li><a href="/booking?search=Switzerland">Switzerland</a></li>
                        <li><a href="/booking?search=Japan">Japan</a></li>
                        <li><a href="/booking?search=Morocco">Morocco</a></li>
                    </ul>
                    <ul>
                        <li><a href="/booking?search=Greece">Greece</a></li>
                        <li><a href="/booking?search=Tanzania">Tanzania</a></li>
                        <li><a href="/booking?search=Chile">Chile</a></li>
                    </ul>
                </div>
            </div>
            <div class="footer-col contact-info">
                <h5>Atlas Escapes</h5>
                <p>concierge@atlasescapes.com</p>
                <p>+1 (800) 555-0194</p>
            </div>
        </div>
    </footer>
</main>